{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "DATABASE_URL_TEST", "NEXT_PUBLIC_API_URL", "CI"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "smoke": { "dependsOn": ["build"], "cache": false },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "@farol/api#test": { "dependsOn": ["^build", "@farol/db#test"], "outputs": ["coverage/**"] },
    "@farol/worker#test": {
      "dependsOn": ["^build", "@farol/db#test", "@farol/api#test"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": { "dependsOn": ["^build"], "cache": false },
    "test:mutation": { "dependsOn": ["^build"], "cache": false, "outputs": ["reports/mutation/**"] }
  }
}
