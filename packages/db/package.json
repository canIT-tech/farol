{
  "name": "@farol/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts",
    "db:seed": "tsx src/seed-catalog-cli.ts",
    "research:destinations": "node scripts/research-destinations.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0"
  }
}
