{
  "name": "@farol/api",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/worker-exports.d.ts",
      "default": "./dist/worker-exports.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:mutation": "stryker run",
    "smoke": "node test/boot-smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.46",
    "@ai-sdk/groq": "4.0.35",
    "@ai-sdk/openai": "4.0.53",
    "@farol/db": "workspace:*",
    "@farol/domain": "workspace:*",
    "@farol/providers": "workspace:*",
    "@farol/shared": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@sentry/nestjs": "^11.0.0",
    "ai": "7.0.87",
    "drizzle-orm": "^0.33.0",
    "jose": "^6.2.10",
    "next": "^15.0.0",
    "pg-boss": "^12.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "22.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/vitest-runner": "^8.6.0",
    "@swc/core": "^1.7.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "postgres": "^3.4.4",
    "supertest": "^7.0.0",
    "unplugin-swc": "^1.5.1"
  }
}
