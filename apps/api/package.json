{
  "name": "@farol/api",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/worker-exports.d.ts",
      "default": "./dist/worker-exports.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:mutation": "stryker run",
    "smoke": "node test/boot-smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/groq": "4.0.78",
    "@ai-sdk/openai": "4.0.111",
    "@farol/db": "workspace:*",
    "@farol/domain": "workspace:*",
    "@farol/providers": "workspace:*",
    "@farol/shared": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@sentry/nestjs": "^11.11.0",
    "ai": "7.0.166",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "next": "^16.4.6",
    "pg-boss": "^12.38.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.2",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "postgres": "^4.1.0",
    "supertest": "^7.3.2",
    "unplugin-swc": "^2.0.0"
  }
}
