{
  "name": "@farol/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.worker.ts",
    "start": "node dist/main.worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@farol/api": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@farol/db": "workspace:*",
    "@farol/shared": "workspace:*",
    "@nestjs/testing": "^10.4.0",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/vitest-runner": "^8.6.0",
    "@swc/core": "^1.7.0",
    "@types/node": "^22.0.0",
    "drizzle-orm": "^0.33.0",
    "postgres": "^3.4.4",
    "tsx": "^4.19.0",
    "unplugin-swc": "^1.5.1"
  }
}
