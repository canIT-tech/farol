{
  "name": "@farol/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.worker.ts",
    "start": "node dist/main.worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run",
    "smoke": "node test/boot-smoke.mjs"
  },
  "dependencies": {
    "@farol/api": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@farol/db": "workspace:*",
    "@farol/shared": "workspace:*",
    "@nestjs/testing": "^12.1.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.4",
    "tsx": "^4.23.15",
    "unplugin-swc": "^2.0.0"
  }
}
