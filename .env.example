# ATENCAO: este arquivo e so a LISTA DE NOMES. Os valores vivem no Doppler
# (projeto farol, configs dev / prd). Nao existe .env: rode a aplicacao com
#   doppler setup --no-interactive   (uma vez, le o doppler.yaml)
#   doppler run -- pnpm dev
# Deploy: o Claude le do Doppler por MCP e escreve nas envs do Render.
# Ver docs/superpowers/specs/2026-09-02-deploy-render-doppler-design.md.

# Postgres do Supabase (connection string direta ou pooler)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/farol
# Postgres separado so para os testes. O docker-compose cria o farol_test junto
# com o farol. Necessario: o client.spec de @farol/db derruba tabelas, entao a
# suite rodando contra o banco de desenvolvimento zera o seu catalogo.
# Se preferir sem banco separado, COMENTE a linha — nao deixe vazia: os specs
# fazem `DATABASE_URL_TEST ?? DATABASE_URL` e ?? nao cai no fallback com string
# vazia, entao vazio quebra os testes com mensagem enganosa.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/farol_test

# API (default 3333; no Render é 10000)
#API_PORT=3333

# Supabase Auth (Passo 2): a api valida o JWT pelo JWKS público do projeto.
SUPABASE_JWKS_URL=

# LLM (opcional). A aplicacao SOBE SEM NENHUMA destas: sem elas, descoberta de
# destino, geracao de roteiro e chat respondem 503 (llm_not_configured), e o
# resto do app funciona normal.
# Se voce definir LLM_PROVIDER, as outras tres passam a ser obrigatorias.
# Provider aceito: anthropic | groq | openai. Uma chave, um provider por vez.
# Groq no MVP (free tier). Use os gpt-oss, nao os llama: no Groq so os gpt-oss
# e o qwen tem structured output com JSON schema, e rankDestinations e
# buildItinerary dependem disso. Os llama so tem json_object, que nao garante
# o schema.
#LLM_PROVIDER=groq
#LLM_API_KEY=
#LLM_MODEL_CAPABLE=openai/gpt-oss-120b
#LLM_MODEL_CHEAP=openai/gpt-oss-20b
# Free tier da Groq (2026-09-02): 30 RPM, 1000 RPD, 8000 TPM, 200k TPD nos dois
# modelos. Com o uso medido isso da ~43 roteiros por dia e ~2,8 por minuto.
# Em teste use LLM_PROVIDER=fake: nao queima cota e e deterministico.

# E-mail transacional (waitlist). Opcional, mesmo desenho do LLM: sem
# EMAIL_PROVIDER o envio fica desligado e o cadastro na waitlist segue (a linha
# fica com welcome_sent_at nulo). Provider aceito: resend | fake.
# Resend free: 3.000/mês, 100/dia; sem domínio verificado só entrega para o
# e-mail da própria conta (remetente onboarding@resend.dev).
#EMAIL_PROVIDER=resend
#EMAIL_API_KEY=
#EMAIL_FROM=Farol <onboarding@resend.dev>

# Jobs - pg-boss (Passo 4). Schema dedicado no mesmo Postgres; default pgboss.
#JOBS_SCHEMA=pgboss

# Amadeus Self-Service (Passo 5)
# Travelpayouts (Aviasales) — provider de voo. Token da conta e marker de afiliado.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_BASE_URL=https://api.travelpayouts.com
TRAVELPAYOUTS_CURRENCY=brl
GEO_DUMP_TTL_SECONDS=86400
# LiteAPI (Nuitée) — provider de hotel. Sandbox começa com "sand_".
LITEAPI_KEY=
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_CURRENCY=BRL
LITEAPI_GUEST_NATIONALITY=BR
HOTEL_SEARCH_RADIUS_METERS=5000
FLIGHT_DEEPLINK_TEMPLATE=https://www.google.com/travel/flights?q=voos%20{origin}%20{destination}%20{departDate}
HOTEL_DEEPLINK_TEMPLATE=https://www.google.com/travel/hotels/{cityCode}?checkin={checkIn}&checkout={checkOut}
FLIGHT_CACHE_TTL_SECONDS=600
HOTEL_CACHE_TTL_SECONDS=3600

# Google Places (Passo 6). Cache de 24h.
GOOGLE_PLACES_KEY=
PLACES_CACHE_TTL_SECONDS=86400

# Web
NEXT_PUBLIC_API_URL=http://localhost:3333/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Deploy de servico unico (ver render.yaml). Desligadas em desenvolvimento:
# web e worker sobem separados. Ligadas, a api registra os handlers do pg-boss
# no proprio processo e serve o apps/web como catch-all.
#RUN_JOB_HANDLERS=true
#SERVE_WEB=true
